{
  "name": "Proxy Anywhere",
  "version": "1.2.0",
  "minimum_chrome_version": "88",
  "description": "Proxy Anywhere allows you to instantaneously change to your custom proxy from a click of a button.",
  "manifest_version": 3,
  "permissions": [ "proxy", "storage" ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_icon": "img/offline.png"
  },
  "icons": {
    "16": "img/online.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  }
}
